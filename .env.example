# Copy to .env (cp .env.example .env) and fill it in. .env is ignored by git: never commit it.
# Use PRIVATE IPs everywhere: they do not change when the Learner Lab stops and starts the instances.

# ── Databases ───────────────────────────────────────────────
MONGO_HOST=            # private IP of the MongoDB EC2
RDS_HOST=              # private IP of the RDS SQL Server (nslookup <endpoint>), NOT its hostname
SQLSERVER_USER=        # master user of the RDS
SQLSERVER_PASSWORD=    # master password of the RDS

# ── Images (Docker Hub, pinned by digest) ────────────────────
IMAGE_TAG=eva-final-v2  # readable tag; manifests are additionally pinned by @sha256 digest

# ── Optional: bypass the cluster DNS ────────────────────────
# Leave empty to use the Services. If the pod network between the nodes fails, point nginx at the
# NodePorts of the nodes instead, e.g. BACKEND_UPSTREAM=http://10.0.1.20:30081
BACKEND_UPSTREAM=
ANALYTICS_UPSTREAM=

# ── Monitoring en pods (k8s-oas; NodePorts en el nodo de control) ──
GRAFANA_ADMIN_PASSWORD=   # password del admin de Grafana; k8s-oas/apply.sh crea el Secret con este valor
